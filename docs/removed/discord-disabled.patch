-}
-
-fn answer_ping(pipe: &mut impl Write, frame: &Frame) -> io::Result<bool> {
-    if frame.opcode == 3 {
-        write_frame(pipe, 4, &frame.body)?;
-        Ok(true)
-    } else {
-        Ok(false)
-    }
-}
