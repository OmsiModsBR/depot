-pub fn cleanup_after_update() {
-    let Ok(place) = install_place() else { return };
-    std::thread::spawn(move || {
-        for _ in 0..20 {
-            let mut left = false;
-            if let Ok(rd) = std::fs::read_dir(&place.dir) {
-                for e in rd.flatten() {
-                    let p = e.path();
-                    if p.file_name().map(|n| n.to_string_lossy().ends_with(OLD)).unwrap_or(false) {
-                        remove_any(&p);
-                        left |= p.exists();
