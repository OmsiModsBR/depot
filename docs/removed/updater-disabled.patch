-/// A path short enough for a dialog's line: its end, where the telling part is.
-fn short_path(p: &Path) -> String {
-    let s = p.display().to_string();
-    let n = s.chars().count();
-    if n <= 48 {
-        s
-    } else {
-        format!("…{}", s.chars().skip(n - 46).collect::<String>())
-    }
-}
