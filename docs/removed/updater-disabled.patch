-            if target.exists() {
-                let old = old_of(&target);
-                remove_any(&old);
-                std::fs::rename(&target, &old)?;
-                moved.push((target, None));
-            }
-        }
-        Ok(())
-    })();
-    if let Err(e) = result {
-        // back as it was
-        for (target, old) in moved.into_iter().rev() {
-            match old {
-                Some(old) => {
-                    remove_any(&target);
-                    let _ = std::fs::rename(&old, &target);
-                }
-                None => {
-                    let o = old_of(&target);
-                    if o.exists() {
