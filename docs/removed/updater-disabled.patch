-            }
-            moved.push((target.clone(), had.then_some(old)));
-            std::fs::rename(staging.join(name), &target).map_err(|e| anyhow::anyhow!("{} cannot be written ({e})", short_path(&target)))?;
-        }
-        for name in &gone {
