-/// Whether files can be put into `dir` (the check before anything is downloaded).
-fn writable(dir: &Path) -> bool {
-    let probe = dir.join(".depot-write-test");
-    let ok = std::fs::write(&probe, b"").is_ok();
-    let _ = std::fs::remove_file(&probe);
-    ok
-}
