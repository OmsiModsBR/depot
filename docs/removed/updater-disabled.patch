-                } else {
-                    format!("HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", rest.len())
-                };
-                let _ = c.write_all(head.as_bytes());
-                // (the first answer breaks off at 40 %)
