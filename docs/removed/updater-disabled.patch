-        let ranges = Arc::new(Mutex::new(Vec::<u64>::new()));
-        let seen = ranges.clone();
-        std::thread::spawn(move || {
-            for (n, conn) in listener.incoming().enumerate() {
-                let Ok(mut c) = conn else { continue };
